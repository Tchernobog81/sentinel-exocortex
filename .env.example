# Cortex Loom Configuration

# Backend URL (FastAPI local ou distant)
BACKEND_URL=http://localhost:8000/api/data

# Fichier de données local (fallback)
LOCAL_DATA_FILE=loom_data.json

# Intervalle de scan (secondes)
SCAN_INTERVAL=3600

# Type de stockage pour le backend (json ou sqlite)
STORAGE_TYPE=json
STORAGE_PATH=loom_data.json

# Port du backend
PORT=8000

# Clé API Gemini (optionnel pour analyse IA)
GEMINI_API_KEY=

# LLM local (Ollama) pour l'analyse Pharmakon v117 avec outils de recherche web
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:8b
OLLAMA_FALLBACK_MODELS=qwen3:8b
ANALYSIS_MODE=llm        # "llm" (Ollama outillé) ou "simulate" (heuristique)
MAX_TOOL_ITERATIONS=4
